# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repo (ya está en .gitignore).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API > Secret key (NO exponer al cliente)
SUPABASE_SECRET_KEY=

# PIN de acceso al panel del master (elige uno para el evento)
MASTER_PIN=
